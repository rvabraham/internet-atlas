PORT=3000
# Optional separate local workspace for QA. Defaults to .atlas/.
# ATLAS_DIRECTORY=/absolute/path/to/qa-workspace
# Codex uses your existing local ChatGPT sign-in. No OpenAI API key is required.
# Optional GitHub token increases the public API rate limit.
# GITHUB_TOKEN=
# Optional path if codex is not available in your shell PATH.
# CODEX_BIN=/absolute/path/to/codex
# Optional local override for the bundled outreach editing skill.
# ATLAS_UNSLOP_SKILL=/absolute/path/to/unslop/SKILL.md
