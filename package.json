{
  "name": "internet-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local server/index.mjs",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.mjs",
    "test": "node --test tests/*.test.mjs",
    "analyze": "node --env-file-if-exists=.env.local scripts/analyze.mjs",
    "understand": "node --env-file-if-exists=.env.local scripts/understand.mjs",
    "collect": "node --env-file-if-exists=.env.local scripts/collect.mjs",
    "import": "node --env-file-if-exists=.env.local scripts/import.mjs",
    "expand": "node --env-file-if-exists=.env.local scripts/expand.mjs",
    "merge": "node scripts/merge.mjs",
    "datasets": "node --env-file-if-exists=.env.local scripts/datasets.mjs",
    "eval:scope": "node --env-file-if-exists=.env.local scripts/eval-scope.mjs",
    "index:nodes": "node --env-file-if-exists=.env.local scripts/index-nodes.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/transformers": "^4.3.1",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "vis-data": "^8.0.0",
    "vis-network": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
